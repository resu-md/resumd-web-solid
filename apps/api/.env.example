# `development` or `production`
NODE_ENV=development
PORT=8787

# Where your SPA lives (used for safe redirects back)
APP_ORIGIN=http://localhost:5173
# Where THIS API lives (must match GitHub App callback URL: /api/auth/callback)
BACKEND_ORIGIN=http://localhost:8787

# GitHub App OAuth (user-to-server) credentials
GITHUB_CLIENT_ID=lv1.xxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GitHub App installation auth (bot commits), found in your GitHub App settings
GITHUB_APP_ID=123456
# GitHub App slug (https://github.com/apps/<slug>)
GITHUB_APP_SLUG=resu-md

# GitHub App private key (generate in GitHub App settings)
# IMPORTANT: preserve newlines. Common approach is using \n in env values:
GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# To use this in Cloudflare Workers, convert the key to PKCS8, convert the key to PKCS8:
# `openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in <keyname.pem> -out private-key-pkcs8.pem`
# Push it to Wrangler secrets:
# `cat private-key-pkcs8.pem | npx wrangler secret put GITHUB_PRIVATE_KEY`

# Cookie encryption secret (at least 32 chars)
COOKIE_SECRET=replace-with-a-long-random-string-of-32+-chars

